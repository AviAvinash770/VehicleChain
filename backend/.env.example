PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Leave empty or set to mongodb://localhost:27017/vehiclechain to use local/in-memory)
MONGODB_URI=

# JWT Secrets
JWT_SECRET=super_secret_vehiclechain_jwt_key_academic_demo_2026
JWT_EXPIRES_IN=7d

# Blockchain Configuration
RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=
# Private key of the deployer / authority account (Account #0 on local Hardhat)
AUTHORITY_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# IPFS Configuration (Optional Pinata keys, falls back to local storage adapter)
PINATA_API_KEY=
PINATA_SECRET_KEY=
PINATA_JWT=
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
